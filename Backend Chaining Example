      "source": [
        "# Backward Chaining Example\n",
        "\n",
        "# Known facts\n",
        "facts = {\"Study\"}\n",
        "\n",
        "# Rule: Pass requires Study\n",
        "rules = {\n",
        "    \"Pass\": \"Study\"\n",
        "}\n",
        "\n",
        "# Goal\n",
        "goal = \"Pass\"\n",
        "\n",
        "print(\"Goal:\", goal)\n",
        "\n",
        "if goal in rules:\n",
        "    required_fact = rules[goal]\n",
        "    print(\"Need to prove:\", required_fact)\n",
        "\n",
        "    if required_fact in facts:\n",
        "        print(\"Fact found:\", required_fact)\n",
        "        print(\"Goal Proved\")\n",
        "    else:\n",
        "        print(\"Goal Cannot Be Proved\")\n",
        "else:\n",
        "    print(\"No rule available\")"
      ]
    }
  ]
